# Copy to .env.local to enable Supabase Auth (Google/GitHub OAuth),
# PostgreSQL + RLS persistence, and private `works` Storage bucket.
# When omitted, AI Mastery Hub runs seamlessly in Guest Mode using IndexedDB + LocalStorage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
